{
  "name": "langchainjs-browsing",
  "version": "1.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "LangChain library that provides browser automation tools for AI agents",
  "license": "MIT",
  "keywords": [
    "langchain",
    "puppeteer",
    "middleware",
    "browser-automation",
    "ai-agents",
    "web-scraping"
  ],
  "author": "Eyuel G. Molla",
  "repository": {
    "type": "git",
    "url": "https://github.com/eyueldk/langchainjs-browsing"
  },
  "bugs": {
    "url": "https://github.com/eyueldk/langchainjs-browsing/issues"
  },
  "homepage": "https://github.com/eyueldk/langchainjs-browsing#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "start": "tsx playground/index.ts",
    "build": "tsdown",
    "prepublishOnly": "pnpm build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@langchain/google-genai": "^2.1.30",
    "prettier": "^3.8.3",
    "tsdown": "^0.17.4",
    "tsx": "^4.19.0",
    "vitest": "^3.1.0"
  },
  "peerDependencies": {
    "langchain": "1.4.0",
    "puppeteer": "24.43.0",
    "typescript": "^5"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "module": "./dist/index.mjs",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer"
    ]
  }
}
